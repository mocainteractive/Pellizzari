<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pellizzari — Analisi Acquisto IEM 2025–2026</title>
  <style>
    /* ─── RESET & BASE ─────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --moca-black:   #0f0f0f;
      --moca-dark:    #1a1a1a;
      --moca-card:    #242424;
      --moca-border:  #333333;
      --moca-orange:  #ff5c00;
      --moca-orange2: #ff7a2e;
      --moca-text:    #e8e8e8;
      --moca-muted:   #888888;
      --moca-white:   #ffffff;

      --donna:   #e05c8a;
      --uomo:    #4a9eff;
      --bambino: #f5c842;
      --outlet:  #ff5c00;
      --arredo:  #7ecb85;
    }

    html { font-size: 16px; }

    body {
      background: var(--moca-black);
      color: var(--moca-text);
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      line-height: 1.6;
      min-height: 100vh;
    }

    a { color: var(--moca-orange); text-decoration: none; }

    /* ─── HEADER ──────────────────────────────────────── */
    header {
      background: var(--moca-dark);
      border-bottom: 2px solid var(--moca-orange);
      padding: 2rem 3rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .logo-block { display: flex; align-items: center; gap: 1rem; }

    .logo-mark {
      width: 40px; height: 40px;
      background: var(--moca-orange);
      border-radius: 6px;
      display: flex; align-items: center; justify-content: center;
      font-weight: 900; font-size: 1.1rem; color: #fff; letter-spacing: -1px;
    }

    .logo-text { font-size: 0.75rem; color: var(--moca-muted); text-transform: uppercase; letter-spacing: 2px; }
    .logo-text strong { display: block; font-size: 1rem; color: var(--moca-white); letter-spacing: 1px; }

    .header-meta { text-align: right; }
    .header-meta h1 { font-size: 1.4rem; font-weight: 700; color: var(--moca-white); }
    .header-meta span { font-size: 0.8rem; color: var(--moca-muted); }

    /* ─── LAYOUT ──────────────────────────────────────── */
    main { max-width: 1200px; margin: 0 auto; padding: 2.5rem 2rem 4rem; }

    /* ─── INTRO TAG ───────────────────────────────────── */
    .tag {
      display: inline-block;
      background: var(--moca-orange);
      color: #fff;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 2px;
      padding: 0.25rem 0.75rem;
      border-radius: 2px;
      margin-bottom: 0.5rem;
    }

    /* ─── SECTION TITLE ───────────────────────────────── */
    .section-intro { margin-bottom: 2.5rem; }
    .section-intro h2 { font-size: 1.8rem; font-weight: 700; color: var(--moca-white); margin-bottom: 0.4rem; }
    .section-intro p { color: var(--moca-muted); font-size: 0.9rem; }

    /* ─── SUMMARY CARDS ───────────────────────────────── */
    .summary-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 1rem;
      margin-bottom: 3rem;
    }

    .summary-card {
      background: var(--moca-card);
      border: 1px solid var(--moca-border);
      border-radius: 8px;
      padding: 1.25rem 1.5rem;
      border-top: 3px solid var(--color);
      transition: transform .2s;
    }
    .summary-card:hover { transform: translateY(-2px); }

    .summary-card .label {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: var(--moca-muted);
      margin-bottom: 0.4rem;
    }
    .summary-card .amount {
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--moca-white);
    }
    .summary-card .pct {
      font-size: 0.8rem;
      color: var(--color);
      font-weight: 600;
      margin-top: 0.2rem;
    }
    .summary-card .bar-bg {
      height: 3px;
      background: var(--moca-border);
      border-radius: 2px;
      margin-top: 0.75rem;
    }
    .summary-card .bar-fill {
      height: 3px;
      background: var(--color);
      border-radius: 2px;
    }

    /* ─── SEGMENT SECTION ─────────────────────────────── */
    .segment { margin-bottom: 3.5rem; }

    .segment-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.25rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--moca-border);
    }

    .segment-dot {
      width: 14px; height: 14px;
      border-radius: 50%;
      background: var(--color);
      flex-shrink: 0;
    }

    .segment-header h2 {
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--moca-white);
      text-transform: uppercase;
      letter-spacing: 2px;
    }

    .segment-total {
      margin-left: auto;
      text-align: right;
    }
    .segment-total .tot-label { font-size: 0.7rem; color: var(--moca-muted); text-transform: uppercase; letter-spacing: 1px; }
    .segment-total .tot-value { font-size: 1.1rem; font-weight: 700; color: var(--moca-white); }

    /* ─── TABLE ───────────────────────────────────────── */
    .table-wrap {
      overflow-x: auto;
      border-radius: 8px;
      border: 1px solid var(--moca-border);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.87rem;
    }

    thead tr {
      background: var(--moca-card);
    }

    thead th {
      padding: 0.75rem 1rem;
      text-align: left;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: var(--moca-muted);
      white-space: nowrap;
      border-bottom: 1px solid var(--moca-border);
    }

    thead th.right { text-align: right; }

    tbody tr {
      border-bottom: 1px solid var(--moca-border);
      transition: background .15s;
    }
    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background: rgba(255,255,255,0.03); }

    tbody td {
      padding: 0.65rem 1rem;
      vertical-align: middle;
    }

    .rank {
      width: 32px;
      font-size: 0.75rem;
      color: var(--moca-muted);
      font-weight: 600;
    }

    .cat2-badge {
      display: inline-block;
      font-size: 0.65rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      padding: 0.15rem 0.5rem;
      border-radius: 3px;
      background: rgba(255,255,255,0.07);
      color: var(--moca-muted);
      margin-bottom: 0.15rem;
    }

    .cat3-name {
      font-weight: 600;
      color: var(--moca-white);
    }

    .amount-cell {
      text-align: right;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
      font-weight: 600;
      color: var(--moca-white);
    }

    .pct-cell {
      text-align: right;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
      color: var(--color, var(--moca-orange));
      font-weight: 700;
    }

    .cum-cell {
      text-align: right;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
      color: var(--moca-muted);
      font-size: 0.8rem;
    }

    .bar-cell { width: 120px; }

    .mini-bar-bg {
      height: 6px;
      background: var(--moca-border);
      border-radius: 3px;
      overflow: hidden;
    }
    .mini-bar-fill {
      height: 6px;
      border-radius: 3px;
      background: var(--color, var(--moca-orange));
    }

    /* highlight top row */
    tbody tr.top-row { background: rgba(255,255,255,0.04); }
    tbody tr.top-row .cat3-name { color: var(--color, var(--moca-orange)); }

    /* ─── INSIGHT BOX ─────────────────────────────────── */
    .insight {
      background: var(--moca-card);
      border-left: 3px solid var(--color, var(--moca-orange));
      border-radius: 0 6px 6px 0;
      padding: 0.9rem 1.2rem;
      margin-top: 1rem;
      font-size: 0.85rem;
      color: var(--moca-muted);
    }
    .insight strong { color: var(--moca-white); }

    /* ─── FOOTER ──────────────────────────────────────── */
    footer {
      background: var(--moca-dark);
      border-top: 1px solid var(--moca-border);
      padding: 1.5rem 3rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
      font-size: 0.78rem;
      color: var(--moca-muted);
    }
    footer span { display: flex; align-items: center; gap: 0.4rem; }
    footer .dot-orange { color: var(--moca-orange); }

    /* ─── RESPONSIVE ──────────────────────────────────── */
    @media (max-width: 640px) {
      header { padding: 1.5rem; flex-direction: column; align-items: flex-start; }
      .header-meta { text-align: left; }
      main { padding: 1.5rem 1rem; }
      .bar-cell, .cum-cell { display: none; }
    }
  </style>
</head>
